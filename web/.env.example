# Mapbox public access token (starts with pk.). Create one at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=
# FloodIQ backend origin. Leave empty in development: Vite proxies /api to http://localhost:3001.
# Databricks credentials live in backend/.env only — never put them in a VITE_ variable.
VITE_API_URL=
# Fallback well snapshot (built from daily_production.parquet) used when the backend is unavailable.
VITE_WELLS_URL=/data/wells.geojson
